; Biblioteca estandar minima para Windows x64.
; Las funciones que cruzan la ABI nativa permanecen en la frontera unsafe.

clause System 'windows'

extern "kernel32":
    GetStdHandle(nStdHandle: uint32) *: void
    WriteFile(
        hFile *: void,
        lpBuffer *: const void,
        nNumberOfBytesToWrite: uint32,
        lpNumberOfBytesWritten *: uint32,
        lpOverlapped *: void
    ) int32

@assembler
func _win32_count(value: uint64) uint32:
    #prep assembler "intel"
        mov rax, {value}
    #end
    return asm

@unsafe
func _serialize_int_at_raw(
    output: char[],
    output_len: uint64,
    position: uint64,
    value: int32,
    value_size: uint64
) uint64:
    digits_text: chain = "0123456789"
    if value_size != 4:
        return 0
    if position >= output_len:
        return 0

    negative: bool = value < 0
    digits: uint64 = 0
    cursor: int32 = value
    digit: int = 0
    nul: char
    if value == 0:
        digits = 1
    elif negative:
        while cursor < 0:
            digits += 1
            cursor /= 10
    else:
        while cursor > 0:
            digits += 1
            cursor /= 10

    required: uint64 = digits
    if negative:
        required += 1
    required += 1
    end: uint64 = position
    end += required
    if end > output_len:
        return 0

    if negative:
        output[position] = "-"
        position += 1

    write_position: uint64 = position
    write_position += digits
    write_position -= 1
    cursor = value
    if value == 0:
        output[write_position] = "0"
    elif negative:
        while cursor < 0:
            digit = 0 - (cursor % 10)
            output[write_position] = digits_text[digit]
            write_position -= 1
            cursor /= 10
    else:
        while cursor > 0:
            digit = cursor % 10
            output[write_position] = digits_text[digit]
            write_position -= 1
            cursor /= 10

    nul_position: uint64 = position
    nul_position += digits
    output[nul_position] = nul

    written: uint64 = digits
    if negative:
        written += 1
    return written

@unsafe
func serialize_int(
    output: char[],
    output_len: Len_t,
    value: int32,
    value_size: Size_t
) uint64:
    position: uint64 = 0
    while position < output_len && output[position] != 0:
        position += 1
    return _serialize_int_at_raw(output, output_len, position, value, value_size)

@unsafe
func serialize_int_at(
    output: char[],
    output_len: Len_t,
    position: uint64,
    value: int32,
    value_size: Size_t
) uint64:
    return _serialize_int_at_raw(output, output_len, position, value, value_size)

@unsafe
func printa(buffer: char[], long: Len_t, size: Size_t) void:
    handle *: void = GetStdHandle(4294967285)
    if long != size:
        return
    if size > 4294967295:
        return
    WriteFile(handle, $buffer[0], _win32_count(size), Null, Null)
    return

@unsafe
func printb(
    buffer: byte[],
    long: Len_t,
    size: Size_t,
    hexadecimal: bool
) void:
    handle *: void = GetStdHandle(4294967285)
    if long != size:
        return

    if hexadecimal:
        digits: chain = "0123456789ABCDEF"
        index: uint64 = 0
        value: byte = 0
        high: int = 0
        low: int = 0
        pair: char[3] = "00"
        while index < long:
            value = buffer[index]
            high = value / 16
            low = value % 16
            pair[0] = digits[high]
            pair[1] = digits[low]
            WriteFile(handle, $pair[0], 2, Null, Null)
            index += 1
        return

    if size > 4294967295:
        return
    if size > 0:
        WriteFile(handle, $buffer[0], _win32_count(size), Null, Null)
    return

@unsafe
func print(text: chain, length: Len_t) void:
    handle *: void = GetStdHandle(4294967285)
    count: uint64 = 0
    if length > 0:
        count = length
        count -= 1
    if count > 4294967295:
        return
    if count > 0:
        WriteFile(handle, $text[0], _win32_count(count), Null, Null)
    return
