; ==============================================================================
; Firmas de Simple DirectMedia Layer 3 (SDL3) para EGL
; ==============================================================================
@header SDL3/SDL.h
@link SDL3
@bin SDL3.dll

; --- Inicializacion y Ciclo de Vida ---
bool SDL_Init(uint flags)
void SDL_Quit()
pstring SDL_GetError()
void SDL_ClearError()

; --- Manejo de Ventanas ---
ptr SDL_CreateWindow(pstring title, int w, int h, uint64 flags)
void SDL_DestroyWindow(ptr window)
bool SDL_ShowWindow(ptr window)
bool SDL_HideWindow(ptr window)
ptr SDL_GetWindowTitle(ptr window)
bool SDL_SetWindowTitle(ptr window, pstring title)
bool SDL_SetWindowPosition(ptr window, int x, int y)
bool SDL_GetWindowPosition(ptr window, int* x, int* y)
bool SDL_SetWindowSize(ptr window, int w, int h)
bool SDL_GetWindowSize(ptr window, int* w, int* h)
bool SDL_SetWindowFullscreen(ptr window, bool fullscreen)
bool SDL_MaximizeWindow(ptr window)
bool SDL_MinimizeWindow(ptr window)
bool SDL_RestoreWindow(ptr window)
bool SDL_RaiseWindow(ptr window)
bool SDL_SetWindowBordered(ptr window, bool bordered)
bool SDL_SetWindowResizable(ptr window, bool resizable)
bool SDL_SetWindowAlwaysOnTop(ptr window, bool on_top)
uint32 SDL_GetWindowFlags(ptr window)

; --- Renderizado 2D ---
ptr SDL_CreateRenderer(ptr window, pstring name)
void SDL_DestroyRenderer(ptr renderer)
bool SDL_SetRenderDrawColor(ptr renderer, uint8 r, uint8 g, uint8 b, uint8 a)
bool SDL_GetRenderDrawColor(ptr renderer, uint8* r, uint8* g, uint8* b, uint8* a)
bool SDL_RenderClear(ptr renderer)
bool SDL_RenderPresent(ptr renderer)
bool SDL_RenderPoint(ptr renderer, float x, float y)
bool SDL_RenderPoints(ptr renderer, ptr points, int count)
bool SDL_RenderLine(ptr renderer, float x1, float y1, float x2, float y2)
bool SDL_RenderLines(ptr renderer, ptr points, int count)
bool SDL_RenderRect(ptr renderer, ptr rect)
bool SDL_RenderRects(ptr renderer, ptr rects, int count)
bool SDL_RenderFillRect(ptr renderer, ptr rect)
bool SDL_RenderFillRects(ptr renderer, ptr rects, int count)
bool SDL_SetRenderViewport(ptr renderer, ptr rect)
bool SDL_GetRenderViewport(ptr renderer, ptr rect)
bool SDL_SetRenderClipRect(ptr renderer, ptr rect)
bool SDL_GetRenderClipRect(ptr renderer, ptr rect)
bool SDL_SetRenderScale(ptr renderer, float scaleX, float scaleY)
bool SDL_GetRenderScale(ptr renderer, float* scaleX, float* scaleY)
bool SDL_SetRenderDrawBlendMode(ptr renderer, uint mode)
bool SDL_GetRenderDrawBlendMode(ptr renderer, uint* mode)

; --- Texturas y Superficies ---
ptr SDL_CreateTexture(ptr renderer, uint format, int access, int w, int h)
ptr SDL_CreateTextureFromSurface(ptr renderer, ptr surface)
void SDL_DestroyTexture(ptr texture)
bool SDL_RenderTexture(ptr renderer, ptr texture, ptr srcrect, ptr dstrect)
bool SDL_RenderTextureRotated(ptr renderer, ptr texture, ptr srcrect, ptr dstrect, double angle, ptr center, int flip)
bool SDL_SetTextureColorMod(ptr texture, uint8 r, uint8 g, uint8 b)
bool SDL_GetTextureColorMod(ptr texture, uint8* r, uint8* g, uint8* b)
bool SDL_SetTextureAlphaMod(ptr texture, uint8 alpha)
bool SDL_GetTextureAlphaMod(ptr texture, uint8* alpha)
bool SDL_SetTextureBlendMode(ptr texture, uint mode)
bool SDL_GetTextureBlendMode(ptr texture, uint* mode)
ptr SDL_CreateSurface(int width, int height, uint format)
void SDL_DestroySurface(ptr surface)
ptr SDL_LoadBMP(pstring file)
bool SDL_SaveBMP(ptr surface, pstring file)

; --- Eventos y Entrada ---
bool SDL_PollEvent(ptr event)
bool SDL_WaitEvent(ptr event)
bool SDL_WaitEventTimeout(ptr event, int32 timeoutMS)
bool SDL_PumpEvents()
void SDL_FlushEvents(uint32 minType, uint32 maxType)
ptr SDL_GetKeyboardState(int* numkeys)
uint32 SDL_GetModState()
uint32 SDL_GetMouseState(float* x, float* y)
uint32 SDL_GetGlobalMouseState(float* x, float* y)
uint32 SDL_GetRelativeMouseState(float* x, float* y)
bool SDL_WarpMouseInWindow(ptr window, float x, float y)
bool SDL_SetRelativeMouseMode(bool enabled)
bool SDL_GetRelativeMouseMode()
bool SDL_ShowCursor()
bool SDL_HideCursor()
bool SDL_CursorVisible()

; --- Tiempo y Sistema ---
void SDL_Delay(uint32 ms)
void SDL_DelayNS(uint64 ns)
uint64 SDL_GetTicks()
uint64 SDL_GetTicksNS()
uint64 SDL_GetPerformanceCounter()
uint64 SDL_GetPerformanceFrequency()
pstring SDL_GetBasePath()
pstring SDL_GetPrefPath(pstring org, pstring app)
