; Prueba mínima del buffer dinámico nativo de Bagron.

clause System 'windows'
clause Arch 'amd'

import time
import io

func test_buffer() int32:
    data: buffer[4096] = 0
    data[0] = 65
    data[4095] = 90

    result: int32 = 0
    if data[0] == 65:
        if data[4095] == 90:
            result = 1

    Del data
    return result

func create_delete_once() void:
    temporary: buffer[4096] = 0
    Del temporary
    return

@unsafe
func run_buffer_benchmark() void:
    iterations: uint32 = 10000
    start_ticks: int64 = 0
    create_delete_us: int64 = 0
    write_us: int64 = 0
    read_us: int64 = 0
    delete_us: int64 = 0
    checksum: uint64 = 0
    data: buffer[4096] = 0

    start_ticks = time.time_ticks()
    for iteration: uint32 ran (0, 10000, 1):
        create_delete_once()
    create_delete_us = time.time_microseconds(start_ticks, time.time_ticks())

    start_ticks = time.time_ticks()
    for iteration: uint32 ran (0, 10000, 1):
        data[0] = 65
        data[4095] = 90
    write_us = time.time_microseconds(start_ticks, time.time_ticks())

    start_ticks = time.time_ticks()
    for iteration: uint32 ran (0, 10000, 1):
        if data[0] == 65:
            checksum = 1
        if data[4095] == 90:
            checksum = 2
    read_us = time.time_microseconds(start_ticks, time.time_ticks())

    start_ticks = time.time_ticks()
    for iteration: uint32 ran (0, 10000, 1):
        data[0] = 0
        data[4095] = 0
    Del data
    delete_us = time.time_microseconds(start_ticks, time.time_ticks())

    io.print("buffer_create_delete_us=")
    io.print_int(create_delete_us)
    io.print("\nbuffer_write_us=")
    io.print_int(write_us)
    io.print("\nbuffer_read_us=")
    io.print_int(read_us)
    io.print("\nbuffer_delete_phase_us=")
    io.print_int(delete_us)
    io.print("\nbuffer_checksum=")
    io.print_uint(checksum)
    io.print("\n")
    io.flush()
    return
