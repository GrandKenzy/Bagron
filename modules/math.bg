; Raíz cuadrada real por Newton-Raphson. No cruza la ABI del runtime C.
public func sqrt(value: double) double:
    if value <= 0.0:
        return 0.0

    guess: double = value
    if guess < 1.0:
        guess = 1.0

    for iteration: uint32 ran (0, 32, 1):
        guess = (guess + value / guess) / 2.0

    return guess

; Raíz cuadrada entera sin convertir a double.
; Devuelve la raíz truncada: usqrt(15) = 3.
public func usqrt(value: uint64) uint64:
    if value < 2:
        return value

    low: uint64 = 1
    high: uint64 = value
    result: uint64 = 1

    while low <= high:
        midpoint: uint64 = (low + high) / 2
        if midpoint <= value / midpoint:
            result = midpoint
            low = midpoint + 1
        else:
            high = midpoint - 1

    return result
