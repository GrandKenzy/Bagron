; ignora lo de abajo por ahora



class str:
    void __new__(self):
        __void_p_t__ __char_t__ value 
        value = __fronted__ ; el valor que hay delante. __fronted__ solo lo guarda en compilación al igual que __slot__
        __void_p_t__ __char_t__ self._ptr ; con _ lo hacemos privado para encapsular.
        int size = STRING_C.strlen(value)
        self._ptr = C_STDLIB.malloc((char.size * size) + 1)
        self._len = size
        STRING_C.strcpy(self._ptr, value)

    ; los métodos mágicos no requieren @method.
    void __init__(self):
        pass

    void __size__(self): ; para cuando se llama a .size
        return self._len

    @method
    int len(self):
        return self.str
        







