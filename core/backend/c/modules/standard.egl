public class str:
    ptr _ptr
    size_t _len

    void __new__():
        __void_p_t__ __char_t__ 
        value = __fronted__ 
        __size_t__ size = STRING_C.strlen(value)
        self._ptr = C_STDLIB.malloc((char.size * size) + 1)
        self._len = size
        STRING_C.strcpy(self._ptr, value)

    void __init__(pstring VALUE):
        if self._ptr:
            free(self._ptr)
        
        self._ptr = VALUE

    void __delete__():
        if self._ptr:
            free(self._ptr)



    @method
    int len():
        return self._len
        

public class Buffer:
    ptr _ptr
    size_t _len

    void __new__():
        pass

    void __init__(size_t size, __type_t__ t):
        self._ptr = C_STDLIB.malloc(t.size * size)
        if not self._ptr:
            ; Error de asignación de memoria
            self._len = 0
        
        self._len = size

    void __delete__():
        if self._ptr:
            free(self._ptr)
            self._ptr = Null
            self._len = 0

    @method
    size_t len():
        return self._len



