
clause System "baremetal"
clause Arch "amd"
clause Boot "multiboot2"


; ==========================================
; UNIDAD ASM DEL SISTEMA
; ==========================================

#prep assembler module "gas-intel"
    # El contenido de este bloque se conserva en un unico .asm.

    .section .multiboot2,"a"
    .balign 8

    multiboot_start:
        .long 0xE85250D6
        .long 0
        .long multiboot_end - multiboot_start
        .long -(0xE85250D6 + (multiboot_end - multiboot_start))

        # Tag de terminacion
        .short 0
        .short 0
        .long 8

    multiboot_end:


    # ==========================================
    # BOOTSTRAP - MODO PROTEGIDO 32 BITS
    # ==========================================

    .text
    .code32

    .globl _start

    .extern page_table_l4
    .extern page_table_l3
    .extern page_table_l2
    .extern stack_top
    .extern gdt64_ptr
    .extern _start64
    .extern multiboot_info_ptr

    _start:
        cli
        cld

        # Verificar Multiboot2
        cmp eax, 0x36D76289
        jne .detener

        # Guardar informacion del bootloader
        mov DWORD PTR [multiboot_info_ptr], ebx

        # Preparar stack
        mov esp, stack_top

        # Limpiar las tres tablas de paginas
        mov edi, page_table_l4
        xor eax, eax
        mov ecx, 3072
        rep stosd

        # PML4 -> PDPT
        mov eax, page_table_l3
        or eax, 0x03
        mov DWORD PTR [page_table_l4], eax

        # PDPT -> PD
        mov eax, page_table_l2
        or eax, 0x03
        mov DWORD PTR [page_table_l3], eax

        # Identity mapping de 2 MiB
        mov DWORD PTR [page_table_l2], 0x83

        # Cargar PML4
        mov eax, page_table_l4
        mov cr3, eax

        # Activar PAE
        mov eax, cr4
        or eax, (1 << 5)
        mov cr4, eax

        # Activar EFER.LME
        mov ecx, 0xC0000080
        rdmsr
        or eax, (1 << 8)
        wrmsr

        # Activar paginacion
        mov eax, cr0
        or eax, (1 << 31)
        mov cr0, eax

        # Cargar GDT
        lgdt [gdt64_ptr]

        # Saltar al kernel AMD64
        ljmp 0x08, offset _start64

    .detener:
        cli
    .esperar:
        hlt
        jmp .esperar


    # ==========================================
    # KERNEL - MODO LARGO 64 BITS
    # ==========================================

    .text
    .code64

    .globl _start64
    .globl page_table_l4
    .globl page_table_l3
    .globl page_table_l2
    .globl gdt64_ptr
    .globl stack_top
    .globl multiboot_info_ptr

    _start64:
        # Inicializar segmentos
        xor ax, ax
        mov ds, ax
        mov es, ax
        mov ss, ax

        # Preparar stack de 64 bits
        mov rsp, stack_top
        xor rbp, rbp
        cld

        # Memoria de video VGA
        mov rdi, 0xB8000

        # Mensaje
        lea rsi, [rip + mensaje_hola]

        # Blanco sobre azul
        mov ah, 0x1F

    .bucle_impresion:
        lodsb
        test al, al
        jz .sistema_detenido

        mov WORD PTR [rdi], ax
        add rdi, 2

        jmp .bucle_impresion

    .sistema_detenido:
        cli

    .bucle_espera:
        hlt
        jmp .bucle_espera


    # ==================================
    # GDT
    # ==================================

    .section .rodata,"a"
    .balign 8

    gdt64:
        .quad 0
        .quad 0x00AF9A000000FFFF

    gdt64_end:

    gdt64_ptr:
        .short gdt64_end - gdt64 - 1
        .long gdt64


    # ==================================
    # DATOS
    # ==================================

    mensaje_hola:
        .asciz "Kernel corriendo en AMD64 - Bagron"


    # ==================================
    # MEMORIA RESERVADA
    # ==================================

    .section .bss,"aw"

    .balign 4096
    page_table_l4:
        .space 4096

    page_table_l3:
        .space 4096

    page_table_l2:
        .space 4096

    .balign 4
    multiboot_info_ptr:
        .long 0

    .balign 16
    stack_bottom:
        .space 16384
    stack_top:
#end


func main() int32:
    return 0
