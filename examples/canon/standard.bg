; Fachada de utilidades numericas para el ejemplo Windows.
; La ABI y el algoritmo de serializacion viven en modulos separados.

clause System 'windows'
clause Arch 'amd'

import console
import formatting

; Conserva la API de alto nivel y oculta el nombre de la primitiva Windows.
@unsafe
public func print(text: chain, length: Len_t) void:
    write_text(text)
    return

; Imprime un entero usando el formateador y la salida Windows ya aislados.
@unsafe
public func print_int(value: int32) void:
    buffer: char[32]
    written: usize = serialize_int(buffer, value)
    if written > 0:
        write_chars(buffer, written)
    return
