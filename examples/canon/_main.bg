; Ejecutable canonico: configura el target y coordina los modulos del ejemplo.

clause Arch 'auto'
clause System 'windows'

import standard as std
import time
import alphabet
import model as data
import math as numeric
import assembly as machine

; Datos globales estaticos y literales soportados por LLVM.
limite: const int32 = 10
factor: const double = 3.141516
mascara: uint8 = 31
valores: uint8[] = {1, 2, 3}
puntero *: int32 = Null
nombre: char[10] = "Hola"
bytes: byte[6] = "x0x0xb"
mensaje: chain = "cadena estatica"

; Las llamadas mantienen los metadatos de array como parametros expansivos.
@unsafe
func main() int32:
    global NumericString
    global AlphabetString

    std.print(NumericString)
    std.print(AlphabetString)

    valores_locales: int32[3] = {10, 20, 30}
    resultado: int32 = numeric.sumar_array(valores_locales)

    if data.revisar_agregados() != 7:
        return 41
    if machine.asm_status() != 0:
        return 42

    return resultado
