; Reloj de alta resolucion de Windows aislado tras una API numerica segura.

clause System 'windows'
clause Arch 'amd'

extern "kernel32":
    QueryPerformanceCounter(
        lpPerformanceCount *: int64
    ) int32

    QueryPerformanceFrequency(
        lpFrequency *: int64
    ) int32

@unsafe
public func time_ticks() int64:
    ticks: int64 = 0
    if QueryPerformanceCounter($ticks) == 0:
        return 0
    return ticks

@unsafe
public func time_frequency() int64:
    frequency: int64 = 0
    if QueryPerformanceFrequency($frequency) == 0:
        return 0
    return frequency

; Evita multiplicar el intervalo completo antes de dividir por la frecuencia.
public inline func time_elapsed_ticks(start: int64, end: int64) int64:
    if end < start:
        return 0
    elapsed: int64 = end
    elapsed -= start
    return elapsed

@unsafe
public func time_us(start: int64, end: int64) int64:
    if end < start:
        return 0

    frequency: int64 = time_frequency()
    if frequency <= 0:
        return 0

    elapsed: int64 = end
    elapsed -= start
    seconds: int64 = elapsed / frequency
    remainder: int64 = elapsed % frequency
    microseconds: int64 = seconds * 1000000
    microseconds += (remainder * 1000000) / frequency
    return microseconds
