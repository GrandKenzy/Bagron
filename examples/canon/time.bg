
clause System 'windows'

extern "kernel32":
    QueryPerformanceCounter(
        lpPerformanceCount *: int64
    ) int32

    QueryPerformanceFrequency(
        lpFrequency *: int64
    ) int32

@unsafe
func time_ticks() int64:
    ticks: int64 = 0
    if QueryPerformanceCounter($ticks) == 0:
        return 0
    return ticks

@unsafe
func time_frequency() int64:
    frequency: int64 = 0
    if QueryPerformanceFrequency($frequency) == 0:
        return 0
    return frequency

@unsafe
func time_elapsed_ticks(start: int64, end: int64) int64:
    if end < start:
        return 0

    elapsed: int64 = end
    elapsed -= start
    return elapsed

@unsafe
func time_us(start: int64, end: int64) int64:
    if end < start:
        return 0

    frequency: int64 = time_frequency()
    if frequency <= 0:
        return 0

    elapsed: int64 = end
    elapsed -= start

    ; Adecuado para intervalos cortos sin overflow.
    elapsed *= 1000000
    elapsed /= frequency

    return elapsed
