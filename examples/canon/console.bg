; Frontera Windows: solo este modulo conoce la ABI de kernel32.

clause System 'windows'
clause Arch 'amd'

import alphabet

; GetStdHandle devuelve un handle estable durante la vida del proceso. Se
; inicializa bajo demanda para no pagar esa llamada en cada escritura.
private stdout_handle *: void
private stdout_initialized: bool = false

extern "kernel32":
    GetStdHandle(nStdHandle: uint32) *: void
    WriteFile(
        hFile *: void,
        lpBuffer *: const void,
        nNumberOfBytesToWrite: uint32,
        lpNumberOfBytesWritten *: uint32,
        lpOverlapped *: void
    ) int32

@assembler
private func _win32_count(value: usize) uint32:
    #prep assembler "intel"
        mov rax, {value}
    #end
    return asm

; Punto unico de validacion y escritura para las rutas de texto y bytes.
@unsafe
private func _write_stdout(buffer *: const void, count: usize) void:
    global stdout_handle
    global stdout_initialized
    if not stdout_initialized:
        stdout_handle = GetStdHandle(4294967285)
        stdout_initialized = true
    if count > 4294967295:
        return
    if count > 0:
        WriteFile(stdout_handle, buffer, _win32_count(count), Null, Null)
    return

; Escribe una cantidad explicita sin leer mas alla del array recibido.
@unsafe
public func write_chars(
    buffer: char[],
    length: Len_t,
    size: Size_t,
    count: usize
) void:
    if size != 1:
        return
    if count > length:
        return
    if count > 0:
        _write_stdout($buffer[0], count)
    return

; Imprime un buffer de bytes o su representacion hexadecimal.
@unsafe
public func printb(
    buffer: byte[],
    length: Len_t,
    size: Size_t,
    hexadecimal: bool
) void:
    global HexadecimalUpperString
    if size != 1:
        return

    if hexadecimal:
        hex_buffer: char[512]
        write_position: usize = 0
        index: usize = 0
        value: byte = 0
        high: byte = 0
        low: byte = 0
        while index < length:
            value = buffer[index]
            high = value / 16
            low = value % 16
            hex_buffer[write_position] = HexadecimalUpperString[high]
            write_position += 1
            hex_buffer[write_position] = HexadecimalUpperString[low]
            write_position += 1
            if write_position == 512:
                _write_stdout($hex_buffer[0], write_position)
                write_position = 0
            index += 1
        if write_position > 0:
            _write_stdout($hex_buffer[0], write_position)
        return

    if length > 0:
        _write_stdout($buffer[0], length)
    return

; chain incluye un terminador; Windows recibe solo los caracteres visibles.
@unsafe
public func write_text(text: chain, length: Len_t) void:
    count: usize = 0
    if length > 0:
        count = length
        count -= 1
    if count > 0:
        _write_stdout($text[0], count)
    return
